# SABIGOZAR Panel — optional Railway Variables (all optional)
# Telegram support: @SAHEBKARAMI
# Never commit real passwords or tokens to GitHub. Put them in Railway > Variables.

# --- owner account ---
# ADMIN_USERNAME=sabigozar            # first install only
# ADMIN_PASSWORD=                     # 12+ chars, 2 upper, 2 lower, 2 digits, 1 symbol (also password recovery)
# HIDE_PASSWORD_IN_LOGS=0

# --- domain & configs ---
# PUBLIC_DOMAIN=panel.example.com     # only for a custom domain
# CONFIG_TITLE=SABIGOZAR
# SUB_UPDATE_HOURS=6
# FRAGMENT_HOST=1
# MUX=0
# CLEAN_IPS=104.16.1.1,172.67.1.1     # only behind Cloudflare

# --- Reality (needs Railway TCP Proxy on port 8443) ---
# REALITY_SNI=www.cloudflare.com
# REALITY_DEST=www.cloudflare.com:443

# --- resellers ---
# RESELLER_ROLE=1
# RESELLER_REQUIRE_TEMPLATE=1

# --- Telegram bot, notifications, backups ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_ID=                  # numeric id from @userinfobot
# TELEGRAM_BOT=1
# TELEGRAM_NOTIFY=1
# BACKUP=1
# BACKUP_HOURS=24
# BACKUP_KEEP=7
# BACKUP_CHAT_ID=

# --- reliability ---
# WATCHDOG=1
# WATCHDOG_SECONDS=60
# WATCH_SECONDS=20
# USERS_AUTODELETE_DAYS=-1
